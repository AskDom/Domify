# URL del backend
VITE_API_URL="http://localhost:5000"

# Mismo host que VITE_API_URL pero con esquema ws/wss — lo usa el CSP de
# index.html para el WebSocket de Socket.IO.
VITE_WS_URL="ws://localhost:5000"

# Google Analytics (GA4). Sin esto, no se carga ningún script de analítica.
VITE_GA_MEASUREMENT_ID=""

# Dominio público del sitio — base para las URLs absolutas de SEO (canonical,
# Open Graph, sitemap.xml). Actualizar cuando haya dominio definitivo (hoy
# usa el subdominio *.vercel.app del deploy de prueba como default).
VITE_SITE_URL="https://real-estate-pi-ashen.vercel.app"
